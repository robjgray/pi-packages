{
  "name": "@gotgenes/pi-tanium",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "default": "./src/index.ts"
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "description": "Hardens the file operations a small-model pi agent depends on — fuzzy/shape-recovered `edit` with per-edit `replaceAll` and similar-lines not-found errors, `cat -n` line-numbered `read`, a soft `write` rewrite-loop guard, and the inherited path `Did you mean?` recovery.",
  "author": {
    "name": "Chris Lasher"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gotgenes/pi-packages.git",
    "directory": "packages/pi-tanium"
  },
  "homepage": "https://github.com/gotgenes/pi-packages/tree/main/packages/pi-tanium#readme",
  "bugs": {
    "url": "https://github.com/gotgenes/pi-packages/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "edit",
    "fuzzy-matching",
    "read",
    "write",
    "did-you-mean",
    "path-recovery"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.5"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@earendil-works/pi-coding-agent": "0.80.5",
    "@types/node": "catalog:",
    "rumdl": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:md": "rumdl check *.md",
    "lint": "biome check . && pnpm run lint:md"
  }
}