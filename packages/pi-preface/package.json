{
  "name": "@gotgenes/pi-preface",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "description": "Top-of-mind injection for pi — keeps critical instructions at the front of every generation via the context event, so they never fade from attention as a conversation grows.",
  "author": {
    "name": "Chris Lasher"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gotgenes/pi-packages.git",
    "directory": "packages/pi-preface"
  },
  "homepage": "https://github.com/gotgenes/pi-packages/tree/main/packages/pi-preface#readme",
  "bugs": {
    "url": "https://github.com/gotgenes/pi-packages/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "preface",
    "top-of-mind",
    "context"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.5"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@earendil-works/pi-coding-agent": "0.80.5",
    "@types/node": "catalog:",
    "rumdl": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:md": "rumdl check *.md",
    "lint": "biome check . && pnpm run lint:md"
  }
}
